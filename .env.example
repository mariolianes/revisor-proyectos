# Copia este fichero a .env y rellena lo que uses. .env no se versiona.

# Carpeta donde el docente deja los trabajos. TIENE QUE ESTAR FUERA de este
# repositorio: los PDFs no pueden entrar en el arbol versionado.
REVISOR_CARPETA_ENTREGAS=C:/Users/tu-usuario/01_ALUMNOS

# Persistencia. Sin estas dos, el sistema arranca igual pero guarda solo en
# memoria y lo avisa: al cerrar se pierde lo trabajado.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_KEY=

# Motor de análisis. La clave del profesor: no se versiona, no sale de este
# equipo y solo se usa cuando el análisis llegue a llamarla. Ninguna entrega
# real pasa por aquí hasta que el 19 lo autorice.
OPENAI_API_KEY=

# Modelo con el que se analiza. Sin este valor el sistema arranca igual, pero
# el análisis lo hace el proveedor simulado y lo avisa en pantalla: un
# análisis simulado no es un análisis. Pon aquí el identificador exacto del
# modelo que quieras usar de los que tenga disponibles tu cuenta.
REVISOR_MODELO_ANALISIS=

# Version de criterios con la que se corrige.
REVISOR_VERSION_CRITERIOS=v2026-2027

# Carpeta con los nueve casos historicos del banco de calibracion (Task 14).
# TIENE QUE ESTAR FUERA de este repositorio, igual que
# REVISOR_CARPETA_ENTREGAS: son trabajos reales de alumnos del curso pasado.
# Solo la usa tools/calibrar.py, y solo si se lo indicas: no es una carpeta
# que el editor vigile ni que el resto del sistema toque.
REVISOR_CARPETA_CALIBRACION=C:/Users/tu-usuario/01_CALIBRACION
